# Copy to backend/.env (ignored by Git), fill locally, and restart the backend.
# Calling stays OFF until credentials, HTTPS origin and an approved number are ready.
SAATHI_PHONE_ENABLED=false
SAATHI_PHONE_PUBLIC_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SAATHI_PHONE_NUMBER=
SAATHI_PHONE_MAX_CALLS=5
SAATHI_PHONE_MAX_DURATION=600
SAATHI_PHONE_MAX_TURNS=40
SAATHI_PHONE_VOICE_EN=Google.en-IN-Standard-A
SAATHI_PHONE_VOICE_HI=Google.hi-IN-Standard-A
SAATHI_PHONE_SPEECH_MODEL=default

# Optional shared Gemini interpretation; rules remain the labelled fallback.
SAATHI_GEMINI_API_KEY=
SAATHI_GEMINI_MODEL=gemini-3.8-flash
SAATHI_ENVIRONMENT=local
SAATHI_FIRESTORE_MODE=disabled

# Cloud requires an approved Firestore project and a stable, random signing secret.
# SAATHI_FIRESTORE_PROJECT=your-approved-project
# SAATHI_SESSION_SECRET=generate-a-long-random-secret-locally